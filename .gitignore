# 通用 Python 项目 .gitignore
# 直接复制到每个仓库根目录，改名为 .gitignore

__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# 数据文件（体积大，不要传上去）
*.csv
*.xlsx
*.parquet
data/
!sample_data/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 密钥（绝对不要传到 GitHub）
.env
*.key
credentials.json
